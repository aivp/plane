# Custom image deployment env for docker-compose.custom.yml

COMPOSE_PROJECT_NAME=plane
COMPOSE_PROFILES=lark

# Image names. Use a private registry in production, for example:
# PLANE_IMAGE_REGISTRY=registry.example.com/aidong
PLANE_IMAGE_REGISTRY=local
PLANE_IMAGE_TAG=feishu-lark-20260529
# Local source deployments should keep this as never. If production only pulls
# from a private registry, set it to always or if_not_present.
PLANE_IMAGE_PULL_POLICY=never

# Use a domestic mirror when building images in China.
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

APP_DOMAIN=plane.example.com
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

WEB_URL=https://${APP_DOMAIN}
CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN}
API_BASE_URL=http://api:8000

APP_BASE_URL=https://${APP_DOMAIN}
APP_BASE_PATH=
ADMIN_BASE_URL=https://${APP_DOMAIN}
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://${APP_DOMAIN}
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=https://${APP_DOMAIN}
LIVE_BASE_PATH=/live

# Frontend build-time public URLs. Keep them aligned with the URLs above.
VITE_API_BASE_URL=https://${APP_DOMAIN}
VITE_API_BASE_PATH=/api
VITE_ADMIN_BASE_URL=https://${APP_DOMAIN}
VITE_ADMIN_BASE_PATH=/god-mode
VITE_SPACE_BASE_URL=https://${APP_DOMAIN}
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=https://${APP_DOMAIN}
VITE_LIVE_BASE_PATH=/live
VITE_WEB_BASE_URL=https://${APP_DOMAIN}
VITE_WEB_BASE_PATH=

PLANE_DEBUG=0
GUNICORN_WORKERS=2
SECRET_KEY=change-me-generate-a-long-random-value
LIVE_SERVER_SECRET_KEY=change-me-generate-a-long-random-value

# Database
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
PGDATA=/var/lib/postgresql/data
DATABASE_URL=

# Redis
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

# Object storage
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

API_KEY_RATE_LIMIT=60/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# Proxy certificate settings. Leave CERT_EMAIL empty if TLS is terminated upstream.
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=

# Feishu integration, domestic Feishu only.
IS_LARK_ENABLED=1
LARK_CLIENT_ID=
LARK_CLIENT_SECRET=
LARK_BASE_DOMAIN=feishu.cn
LARK_DEFAULT_WORKSPACE_SLUG=
LARK_DEFAULT_WORKSPACE_ROLE=15
LARK_AUTO_SYNC_ENABLED=0
LARK_OFFBOARDING_POLICY=deactivate_workspace_member
LARK_NOTIFICATIONS_ENABLED=0
LARK_CONNECTOR_ENABLED=1
PLANE_PUBLIC_BASE_URL=https://${APP_DOMAIN}
